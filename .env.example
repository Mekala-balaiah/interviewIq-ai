# ============================================================
# InterviewIQ AI — Environment Variables Example
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ============================================================

# ─── Spring ──────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ─── Database (PostgreSQL) ────────────────────────────────────
DATASOURCE_URL=jdbc:postgresql://localhost:5432/interviewiq_db
DATASOURCE_USERNAME=interviewiq
DATASOURCE_PASSWORD=interviewiq_pass
DB_POOL_MAX=20
DB_POOL_MIN=5

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# ─── Kafka ───────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=interviewiq-group

# ─── Elasticsearch ───────────────────────────────────────────
ELASTICSEARCH_URI=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_SECURE_SECRET_MINIMUM_256_BITS_FOR_HS256
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# ─── Google OAuth2 ───────────────────────────────────────────
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URIS=http://localhost:3000/oauth2/callback

# ─── OpenAI / AI ─────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com

# ─── Mail (SMTP) ─────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=noreply@interviewiq.ai
EMAIL_FROM_NAME=InterviewIQ AI

# ─── File Storage ────────────────────────────────────────────
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# For S3 (production)
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=interviewiq-resumes
# S3_REGION=us-east-1

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_RPM=100
RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_AI_RPM=20

# ─── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Server ──────────────────────────────────────────────────
SERVER_PORT=8080

# ─── AI Features ─────────────────────────────────────────────
AI_RESUME_ENABLED=true
AI_INTERVIEW_ENABLED=true

# ─── Swagger (set false in prod) ─────────────────────────────
SWAGGER_ENABLED=true
API_DOCS_ENABLED=true

# ─── Logging ─────────────────────────────────────────────────
LOG_FILE=/var/log/interviewiq/app.log
